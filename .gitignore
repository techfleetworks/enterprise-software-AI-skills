# Per-machine bootstrap install artifacts (the committed .claude/settings.json IS tracked; these are not).
# The marker, the settings backup, and the install log are specific to one machine's install.
.claude/.esk-installed
.claude/*.esk.bak
.claude/ESK-INSTALL-LOG.md

# App-managed worktree metadata (not part of the repo).
.claude/worktrees/
