node_modules/

# OS / editor noise
.DS_Store
Thumbs.db

# Vendored OWASP source text (CC-BY-SA-4.0), fetched on demand by `npm run vendor:owasp`.
# Not committed: it is kept out of this MIT repo and pulled from the upstream source instead.
# .claude/skills/owasp-secure-coding-bdd/vendor/NOTICE.md is committed (attribution); the fetched text is not.
.claude/skills/owasp-secure-coding-bdd/vendor/cheatsheets-src/
