#!/usr/bin/env node
/**
 * pre-push hook (bootstrap-v2, ADR-0048). A fast LOCAL pre-flight: before a push, run the OFFLINE
 * enterprise gates so a developer catches a failure in seconds instead of waiting on CI.
 *
 * It is MANIFEST-DRIVEN, like every other consumer-side component: it reads gate-manifest.json and runs
 * each listed gate, EXCEPT the gates that need the network (the provenance gate needs the published
 * upstream release asset), which stay a CI concern. Because the parity gate is one of the gates it runs,
 * a manifest gate whose script is missing or drifted is still caught here, not silently skipped.
 *
 * This hook is a convenience, NOT the authority. A developer can bypass it with `git push --no-verify`,
 * and that is fine: the same gates run in CI under the required check, so a bypass is still caught there
 * (the sync-drift "bypass does not escape CI" scenario). Installed by esk-genesis.
 */
import { spawnSync, execSync } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";
import { join, resolve, sep } from "node:path";

// Git runs a hook from the repo root, but resolve it explicitly so the gate env is always right.
// NORMALIZE with resolve(): `git rev-parse --show-toplevel` returns forward slashes even on Windows
// (C:/Users/...), while resolve(root, gate.script) below returns native backslashes (C:\Users\...). Without
// this, `abs.startsWith(root + sep)` compares mismatched separators, the containment check fails for EVERY
// gate, each one is skipped, and the hook exits 0 having run nothing: a hollow pass on Windows. resolve()
// puts root in the same separator convention as abs so the containment check works on every platform.
let root;
try {
  root = resolve(execSync("git rev-parse --show-toplevel", { encoding: "utf8" }).trim());
} catch {
  root = resolve(process.cwd());
}

// Gates that need the network (the published upstream release asset) are CI-only; everything else in the
// manifest is offline and runs here. Keyed by gate id so this stays a tiny, stable list.
const NETWORK_GATES = new Set(["manifest-provenance"]);

const manifestPath = join(root, "gate-manifest.json");
// An ABSENT manifest is the documented convenience case: nothing to pre-check locally, so exit 0 and let CI be
// the authority. But a manifest that is PRESENT yet unparseable, or has no gates array, or lists zero gates,
// means the local pre-flight cannot run what it promised; it fails CLOSED (exit 1), mirroring the CI runner
// (run-manifest-gates.mjs), so a push cannot slip a violation past the hook by also corrupting the manifest (#122).
if (!existsSync(manifestPath)) {
  process.exit(0);
}
let manifest;
try {
  manifest = JSON.parse(readFileSync(manifestPath, "utf8"));
} catch (e) {
  console.error(`\n✖ pre-push: gate-manifest.json is present but could not be parsed (${e.message}); failing closed.`);
  console.error(`Fix the manifest, or push with --no-verify to skip this local check (CI still runs the gates).`);
  process.exit(1);
}
if (!manifest || typeof manifest !== "object" || !Array.isArray(manifest.gates) || manifest.gates.length === 0) {
  console.error(`\n✖ pre-push: gate-manifest.json has no gates to run (missing or empty "gates" array); failing closed.`);
  console.error(`Restore the manifest, or push with --no-verify to skip this local check (CI still runs the gates).`);
  process.exit(1);
}
const gates = manifest.gates;
const env = {
  ...process.env,
  GATE_REPO_ROOT: root,
  GATE_MANIFEST_FILE: manifestPath,
  GATE_DIR: join(root, "scripts", "ci"),
};

const failed = [];
for (const gate of gates) {
  if (typeof gate?.id !== "string" || typeof gate?.script !== "string") continue;
  if (NETWORK_GATES.has(gate.id)) continue; // needs network: CI only
  const abs = resolve(root, gate.script);
  // Never run a script that escapes the repo (a tampered manifest must not turn this into arbitrary exec).
  if (abs !== root && !abs.startsWith(root + sep)) continue;
  // A manifest gate whose script is absent is left to the parity gate (run here) to flag, not run as a gap.
  if (!existsSync(abs)) continue;
  // Pass the gate's declared CLI args (gate.invoke, ADR-0059): how an engineering gate says what to scan
  // (e.g. "." plus the --ignore paths). This MIRRORS the aggregator's schema (run-manifest-gates.mjs, the
  // source of truth): invoke is an array of strings or absent, validated strictly and FAIL-CLOSED otherwise,
  // because a gate that silently loses its args would scan nothing and pass hollow. Without this the offline
  // gates ran argument-free here and failed (no paths given / wrong root), unlike CI which runs them via the
  // aggregator. Passed with no shell, and invoke is parity/provenance-protected, so a value cannot inject.
  let invokeArgs = [];
  if (gate.invoke !== undefined) {
    if (!Array.isArray(gate.invoke) || gate.invoke.some((a) => typeof a !== "string")) {
      console.error(`\n✖ pre-push: gate "${gate.id}" has a malformed invoke (must be an array of strings); failing closed.`);
      process.exit(1);
    }
    invokeArgs = gate.invoke;
  }
  const res = spawnSync(process.execPath, [abs, ...invokeArgs], { stdio: "inherit", env });
  // A crash or signal (status null) counts as a failure, same as a non-zero exit.
  if (res.status !== 0) failed.push(gate.id);
}

if (failed.length) {
  console.error(`\n✖ pre-push: offline gate(s) failed: ${failed.join(", ")}.`);
  console.error(`Fix them before pushing, or push with --no-verify to skip this local check.`);
  console.error(`(CI runs the same gates under the required check, so --no-verify does not escape them.)`);
  process.exit(1);
}
process.exit(0);
